{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the CowBot main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "updater:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/BerryUIKI/CowBot*" }]
    }
  ]
}
